    "version": "0.2.0",
    "configurations": [      
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--dataset",
                "documents_RAGBench/merged_id_triplets_no_duplicates.json",
                "--runs",
                "5"
            ]
        }
    ]
}

